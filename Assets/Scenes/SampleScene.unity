  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u4F7F\u7528\u6B65\u9AA4:\n1.\u8BBE\u7F6Effmpeg.exe\u7684\u8DEF\u5F84
    (\u5982\u679C\u6CA1\u6709,\u5148\u4E0B\u8F7Dffmpeg)\n2.\u5728RawVideos\u6587\u4EF6\u5939\u4E2D\u653E\u5165\u8981\u526A\u8F91\u7684\u89C6\u9891,\u5E76\u9009\u53D6\n3.\u64AD\u653E\u89C6\u9891\uFF0C\u7136\u540E\u901A\u8FC7\u62C9\u53D6\u8FDB\u5EA6\u6761\uFF0C\u5728\u5408\u9002\u7684\u5730\u65B9\u6682\u505C\uFF0C\u6216\u8005\u9010\u5E27\u79FB\u52A8\u7684\u65B9\u5F0F\u9009\u62E9\u7B2C\u4E00\u5E27(\u5982\u679C\u4E0D\u9009\u62E9\uFF0C\u9ED8\u8BA4\u4E3A\u7B2C1\u5E27)\n4.\u70B9\u51FB\u81EA\u52A8\u9009\u53D6\u7ED3\u5C3E\u5E27\n5.\u51FA\u73B0\u9009\u53D6\u7ED3\u675F\u7684\u63D0\u793A\u4E4B\u540E\uFF0C\u5C31\u70B9\u51FB\u622A\u53D6\u89C6\u9891,\u7B49\u5F85\u51FA\u73B0\u622A\u53D6\u5B8C\u6210\u7684\u63D0\u793A,\u5C31\u53EF\u4EE5\u5728ProcessedVideos\u6587\u4EF6\u5939\u4E2D\u627E\u5230\u5904\u7406\u5B8C\u6210\u7684\u89C6\u9891\n\n\u5DE6\u4FA7\u6309\u94AE\u7684\u529F\u80FD(\u4ECE\u5DE6\u5230\u53F3):\n1.\u4E0A\u4E00\u5E27
    2.\u4E0B\u4E00\u5E27 3.\u6682\u505C 4.\u64AD\u653E\n\u64AD\u653E\u952E\u540C\u65F6\u627F\u8F7D\u4E86\u52A0\u8F7D\u7684\u529F\u80FD\uFF0C\u56E0\u6B64\u9009\u53D6\u89C6\u9891\u540E\u8981\u5148\u64AD\u653E\u4E00\u4E0B"
